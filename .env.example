# ── Telegram ──
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Google Gemini (LLM brain) ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Tavily (live news search) ──
TAVILY_API_KEY=your_tavily_api_key_here

# ── Admin ──
ADMIN_TELEGRAM_ID=your_admin_telegram_id_here

# ── NotebookLM ──
# notebooklm-py uses browser-based auth.  Run `notebooklm login` first.
# No env var needed — cookies are stored automatically in ~/.notebooklm/
